{
	"version": "0.2.0",
	"configurations": [
		{
			"type": "chrome",
			"request": "attach",
			"name": "Attach to Neutralino",
			"port": 5006,
			"webRoot": "${workspaceFolder}/resources",
			"preLaunchTask": "Start Neutralino App",
			"timeout": 5000,
			"skipFiles": [
				"<node_internals>/**"
			],
			"sourceMaps": true,
			"smartStep": true
		}
	]
}