{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Start Neutralino App",
			"type": "shell",
			"command": "neu run",
			"isBackground": true,
			"problemMatcher": {
				"owner": "custom",
				"pattern": {
					"regexp": "^.*$"
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "Starting process: neutralino-win_x64.exe",
					"endsPattern": "neu: INFO neu CLI connected with the application."
				}
			}
		}
	]
}