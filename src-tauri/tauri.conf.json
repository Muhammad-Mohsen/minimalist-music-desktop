{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Minimalist Music",
	"version": "2.0.0",
	"identifier": "com.minimalist.music",
	"build": {
		"frontendDist": "../src"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"fullscreen": false,
				"resizable": false,
				"maximizable": false,
				"title": "Minimalist Music",
				"width": 550,
				"height": 213,
				"decorations": false,
				"transparent": true,
				"shadow": false
			}
		],
		"security": {
			"assetProtocol": {
				"scope": [
					"**"
				],
				"enable": true
			},
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
